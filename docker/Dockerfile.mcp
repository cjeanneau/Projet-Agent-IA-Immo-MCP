# === Build stage: install dependencies with uv ===
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY config.py ./
COPY src/mcp/ ./src/mcp/
COPY src/inference/ ./src/inference/
COPY src/utils/ ./src/utils/
COPY scripts/run_mcp.py ./scripts/run_mcp.py

RUN uv sync --no-dev --group mcp --no-cache \
    && find /app/.venv -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null; \
    find /app/.venv -type d -name 'tests' -o -type d -name 'test' | xargs rm -rf 2>/dev/null; \
    true

# === Runtime stage: clean image without uv ===
FROM python:3.12-slim

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy venv and application code from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/config.py ./
COPY --from=builder /app/src/ ./src/
COPY --from=builder /app/scripts/ ./scripts/

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -sf --max-time 2 http://localhost:8100/ || \
        python -c "import socket; s=socket.socket(); s.connect(('localhost', 8100)); s.close()" || exit 1

CMD ["python", "scripts/run_mcp.py"]
