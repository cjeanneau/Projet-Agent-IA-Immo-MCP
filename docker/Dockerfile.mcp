FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv pip install --system --no-cache .

COPY config.py ./
COPY config_agent.py ./
COPY data/bpe_insee.duckdb ./data/bpe_insee.duckdb
COPY src/ ./src/
COPY ./model/ ./model
COPY scripts/run_mcp.py ./scripts/run_mcp.py

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -sf --max-time 2 http://localhost:8100/ || \
        python -c "import socket; s=socket.socket(); s.connect(('localhost', 8100)); s.close()" || exit 1

CMD ["python", "scripts/run_mcp.py"]