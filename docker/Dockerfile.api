# === Build stage: install dependencies with uv ===
FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY config_agent.py ./
COPY src/app/ ./src/app/
COPY src/agents/ ./src/agents/

RUN uv sync --no-dev --group fastapi --no-cache \
    && find /app/.venv -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null; \
    find /app/.venv -type d -name 'tests' -o -type d -name 'test' | xargs rm -rf 2>/dev/null; \
    true

# === Runtime stage: clean image without uv ===
FROM python:3.12-slim

RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy venv and application code from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/config_agent.py ./
COPY --from=builder /app/src/ ./src/

# Create non-root user
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/healthcheck || exit 1

CMD ["python", "-m", "uvicorn", "src.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
